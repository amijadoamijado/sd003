{
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(pwsh -NoProfile -File D:/claudecode/sd003/.claude/skills/sd-upgrade/upgrade.ps1:*)",
      "PowerShell(pwsh -NoProfile -File D:/claudecode/sd003/.claude/skills/sd-upgrade/upgrade.ps1:*)",
      "Bash(pwsh -NoProfile -File D:/claudecode/sd003/.claude/skills/sd-deploy/deploy.ps1:*)",
      "PowerShell(pwsh -NoProfile -File D:/claudecode/sd003/.claude/skills/sd-deploy/deploy.ps1:*)",
      "Bash(bash D:/claudecode/sd003/.claude/skills/sd-upgrade/upgrade.sh:*)",
      "Bash(node D:/claudecode/sd003/scripts/verify-deployment.mjs:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/claim-evidence-stop.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/clasp-deploy-check-stop.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/orchestrator-guard.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-clasp-deploy.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-sd-destructive.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" --deadline=110 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-commit-on-test-fail.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-write-to-protected-dirs.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-write-to-protected-dirs.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-edit-write-on-sd.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-skill-read.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-spec-location.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/sd-watchdog.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/clasp-deploy-tracker.sh\" Edit",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/clasp-deploy-tracker.sh\" Write",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/clasp-deploy-tracker.sh\" Bash",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/deploy-package-reminder.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" --deadline=590 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-review.sh\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/track-skill-read.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-skill-suggest.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/run-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/prune-skill-state.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
